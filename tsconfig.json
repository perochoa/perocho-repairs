// The site, for astro check. Tests (src/**/*.test.ts) run in Node and are left out: checking them
// needs @types/node, and with it installed Vite's types pull Node's globals into the browser code
// too (setTimeout returning a Timeout in SlotPicker). Node strips their types and runs them as is.
{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "worker", "src/**/*.test.ts"]
}
