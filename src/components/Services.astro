---
// Home page: the service cards, each with a photo across the top.
import { Image } from "astro:assets";
import { type CollectionEntry, render } from "astro:content";
import { pricing } from "../services";
import { site } from "../site";

interface Props {
	services: CollectionEntry<"services">[];
}

const renderedServices = await Promise.all(
	Astro.props.services.map(async (service) => ({
		...service,
		Content: (await render(service)).Content,
		price: pricing(service, Astro.props.services),
	})),
);
---

<section id="services" class="band" aria-labelledby="services-title">
	<div class="wrap">
		<div data-reveal>
			<p class="eyebrow">Services</p>
			<h2 id="services-title">What we fix</h2>
		</div>
		<ul class="cards">
			{
				renderedServices.map(({ id, data, Content, price }, i) => (
					<li class="card" data-reveal style={`--i: ${i}`}>
						{data.photo && <Image class="photo" src={data.photo} alt="" width={720} />}
						<h3>{data.title}</h3>
						<div class="body">
							<Content />
						</div>
						{/* The base price stands out, so it reads at a glance; each deal is a line of its own. */}
						<div class="price">
							{price ? (
								<>
									<p class="amount">
										${price.price}
										{price.per && <span class="per">{price.per}</span>}
									</p>
									{price.deals.length > 0 && (
										<ul class="deals">
											{price.deals.map((deal) => (
												<li>{deal}</li>
											))}
										</ul>
									)}
								</>
							) : (
								<p class="amount quote">Message us for a quote</p>
							)}
						</div>
						{site.intakeUrl && (
							<a class="ask" href={`/request/?service=${id}`}>
								Request this repair <span aria-hidden="true">→</span>
							</a>
						)}
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	/* Bleeds to the card's edges and fades out under the title, so the text never sits on the photo. */
	.card :global(.photo) {
		display: block;
		width: calc(100% + 3rem);
		max-width: none;
		height: 7.5rem;
		margin: -1.5rem -1.5rem -1.25rem;
		object-fit: cover;
		border-radius: calc(0.75rem - 1px) calc(0.75rem - 1px) 0 0;
		mask-image: linear-gradient(to bottom, #000 30%, transparent 85%);
	}
	.card .body {
		flex: 1;
		color: var(--muted);
	}
	.card .body :global(p) {
		margin: 0 0 0.75rem;
	}
	.card .body :global(p:last-child) {
		margin-bottom: 0;
	}
	.card .body :global(strong) {
		color: var(--ink);
	}
	.card .body :global(ul) {
		padding-left: 1.125rem;
	}
	.card .body :global(li + li) {
		margin-top: 0.375rem;
	}
	.price {
		margin-top: 1rem;
		padding-top: 0.75rem;
		border-top: 1px solid var(--line);
		font-family: var(--font-mono);
	}
	.amount {
		margin: 0;
		font-size: 1.75rem;
		font-weight: 600;
		line-height: 1.2;
		color: var(--accent);
	}
	.amount .per {
		margin-left: 0.375rem;
		font-size: 0.9rem;
		font-weight: 500;
		color: var(--muted);
	}
	.amount.quote {
		font-size: 1rem;
		font-weight: 500;
	}
	.deals {
		margin: 0.375rem 0 0;
		padding: 0;
		list-style: none;
		font-size: 0.9rem;
		color: var(--ink);
	}
	.deals li + li {
		margin-top: 0.25rem;
	}
</style>
