---
import CharacterCount from "../../components/CharacterCount.astro";
import SlotPicker from "../../components/SlotPicker.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { marketplace } from "../../reviews";
import { feeText, priceText, sameDayRange } from "../../pricing";
import { getServices } from "../../services";
import { site } from "../../site";
// The worker's own limits, so the quantity field can't offer more than it takes and no field takes
// more characters than it keeps.
import { MAX_LENGTH, MAX_QUANTITY } from "../../../worker/src/limits";

const services = await getServices();
// The same-day fee goes by the device, so it follows the service picked; "not sure" gets the range.
const unsureFee = sameDayRange(services);
---

<BaseLayout title={`Request a repair · ${site.name}`} description={`Request a PS5 or controller repair from ${site.name} in ${site.city} and pick a drop-off time online.`}>
	<main class="wrap">
		<p class="eyebrow">Request a repair</p>
		<h1>Tell us about your device</h1>
		<p class="lede">
			Pick a time to drop your device off, and a tech will call or email you about the price and when it'll
			be ready. Nothing is booked until a tech confirms.{" "}
			Prefer Facebook? <a href={site.messengerUrl}>Message us on Messenger</a>
			{
				marketplace && (
					<>
						{" "}or find us on <a href={marketplace.url}>Marketplace</a>
					</>
				)
			}.
		</p>

		{
			site.intakeUrl ? (
				<form method="post" action={`${site.intakeUrl}/request`} data-request>
					<!-- Without a time the worker turns the request down, so the fields only show once there
					     are times to pick. Without JS (no time list) or without open times, point people to
					     the other ways in instead. -->
					<noscript>
						<p class="notice">
							Picking a drop-off time needs JavaScript. <a href={site.messengerUrl}>Message us on Messenger</a> or
							email <a href={`mailto:${site.email}`}>{site.email}</a>, and we'll find a time.
						</p>
					</noscript>
					<p class="notice" data-no-slots tabindex="-1" hidden>
						<span data-no-slots-reason></span> <a href={site.messengerUrl}>Message us on Messenger</a> or email{" "}
						<a href={`mailto:${site.email}`}>{site.email}</a> to ask about a repair, and we'll find a time.
					</p>
					<div class="loading" data-loading hidden>
						<p class="hint">Loading open times…</p>
						<div class="skeleton" aria-hidden="true"><span></span><span></span><span></span></div>
					</div>

					<div class="fields" data-fields hidden>
						<p class="hint">Every field is required unless it says optional.</p>

						<div class="card">
							<fieldset>
								<legend>You</legend>
								<label>
									Name
									<input name="name" autocomplete="name" maxlength={MAX_LENGTH.name} required />
								</label>
								<label>
									Email
									<input type="email" name="email" autocomplete="email" maxlength={MAX_LENGTH.email} required aria-describedby="email-hint" />
								</label>
								<p class="hint" id="email-hint">We'll email you when we get your request, and again when a tech confirms it.</p>
								<label>
									Phone
									<input type="tel" name="phone" autocomplete="tel" inputmode="tel" maxlength={MAX_LENGTH.phone} required aria-describedby="phone-hint" />
								</label>
								<p class="hint" id="phone-hint">With the area code, so a tech can call you about the price.</p>
							</fieldset>
						</div>

						<div class="card">
							<fieldset>
								<legend>The repair</legend>
								<label>
									Service
									<select name="service">
										{
											services.map((service) => (
												<option data-id={service.id} data-fee={feeText(service.data.sameDay)}>
													{service.data.title}
												</option>
											))
										}
										<option value="" data-fee={unsureFee}>Something else, or not sure</option>
									</select>
								</label>
								<!-- One per per-item service, shown and sent only while it's the one picked. Disabled
								     until then, so a hidden one neither blocks the submit nor rides along with it. -->
								{
									services
										.filter((service) => service.data.per)
										.map((service) => (
											<>
												<label data-quantity={service.id} hidden>
													How many {service.data.per}s?
													<input
														type="number"
														name="quantity"
														inputmode="numeric"
														min="1"
														max={MAX_QUANTITY}
														step="1"
														value="2"
														required
														disabled
														aria-describedby={`quantity-hint-${service.id}`}
													/>
												</label>
												<p class="hint" id={`quantity-hint-${service.id}`} data-quantity={service.id} hidden>
													{priceText(service, services)}. A controller has two.
												</p>
											</>
										))
								}
								<label>
									Device and model
									<input name="device" maxlength={MAX_LENGTH.device} placeholder="e.g. DualSense controller, PS5 Slim" required />
								</label>
								<label>
									What's wrong?
									<CharacterCount name="problem" rows={4} maxlength={MAX_LENGTH.problem} required />
								</label>
								<label class="check rush">
									<input type="checkbox" name="rush" value="1" aria-labelledby="rush-label" aria-describedby="rush-hint" />
									<span class="rush-text">
										<span id="rush-label">Same-day (+<span data-same-day-fee>{feeText(services[0].data.sameDay)}</span>)</span>
										<span class="hint" id="rush-hint">
											Same-day repairs go to the front of the queue. You pay for it in person, with the repair.
										</span>
									</span>
								</label>
							</fieldset>
						</div>

						<SlotPicker url={`${site.intakeUrl}/slots`} />

						<div class="card">
							<label>
								<span>Anything else? <span class="optional">(optional)</span></span>
								<CharacterCount name="notes" rows={3} maxlength={MAX_LENGTH.notes} aria-describedby="notes-hint" />
							</label>
							<p class="hint" id="notes-hint">What you've tried, or anything you're bringing with it.</p>
						</div>

						<!-- Hidden from people; bots fill it in. -->
						<div class="trap" aria-hidden="true">
							<label>
								Leave this empty
								<input name="website" tabindex="-1" autocomplete="off" />
							</label>
						</div>

						<button class="button" type="submit">
							<span class="spinner" aria-hidden="true"></span>
							<span data-send-label>Send request</span>
						</button>
					</div>
				</form>
			) : (
				<p>
					<a class="button" href={site.messengerUrl}>Message us</a>
				</p>
			)
		}
	</main>
</BaseLayout>

<script>
	import { validEmail, validPhone } from "../../../worker/src/limits";

	const form = document.querySelector<HTMLFormElement>("form[data-request]");

	if (form) {
		const send = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
		const sendLabel = send.querySelector<HTMLElement>("[data-send-label]")!;
		const fields = form.querySelector<HTMLElement>("[data-fields]")!;
		const loading = form.querySelector<HTMLElement>("[data-loading]")!;
		const noSlots = form.querySelector<HTMLElement>("[data-no-slots]")!;
		const noSlotsReason = noSlots.querySelector<HTMLElement>("[data-no-slots-reason]")!;
		loading.hidden = false;

		// The time picker says whether there are times. A request needs one, so with none to pick
		// there's nothing to send: leave out the form and point them to Messenger and email. If the
		// times run out while they're filling it in, what they typed stays, hidden, in case times come
		// back.
		form.addEventListener("slots-open", () => {
			loading.hidden = true;
			fields.hidden = false;
			noSlots.hidden = true;
		});
		form.addEventListener("slots-unavailable", (event) => {
			const hadFocus = fields.contains(document.activeElement);
			loading.hidden = true;
			fields.hidden = true;
			noSlots.hidden = false;
			noSlotsReason.textContent = (event as CustomEvent<string>).detail;
			if (hadFocus) noSlots.focus();
		});

		// The worker's own checks, so the form can't pass an address or a number the worker then turns
		// down. An empty field is left to `required`, which has its own message. The browser's check of
		// an email field is looser than the worker's: it takes "jane@localhost", with no dot.
		const email = form.querySelector<HTMLInputElement>("[name=email]")!;
		email.addEventListener("input", () => {
			const valid = email.value === "" || validEmail(email.value);
			email.setCustomValidity(valid ? "" : "Enter your email address in full, like jane@example.com.");
		});
		const phone = form.querySelector<HTMLInputElement>("[name=phone]")!;
		phone.addEventListener("input", () => {
			const valid = phone.value === "" || validPhone(phone.value);
			phone.setCustomValidity(valid ? "" : "Enter your phone number with its area code, like 416-555-0123.");
		});

		// "Request this repair" on a service card links here with ?service=<id>.
		const wanted = new URLSearchParams(location.search).get("service");
		const service = form.querySelector<HTMLSelectElement>("[name=service]")!;
		const match = [...service.options].find((option) => option.dataset.id === wanted);
		if (match) match.selected = true;

		// Per-item services ask how many. Only the picked service's count shows and is sent.
		const quantities = [...form.querySelectorAll<HTMLElement>("[data-quantity]")];
		const showQuantity = () => {
			const picked = service.selectedOptions[0]?.dataset.id;
			for (const element of quantities) {
				const shown = element.dataset.quantity === picked;
				element.hidden = !shown;
				element.querySelector("input")?.toggleAttribute("disabled", !shown);
			}
		};
		service.addEventListener("change", showQuantity);
		showQuantity();

		// The same-day fee is by device: the picked service's, or the range when it's not one of them.
		// The worker charges the same by service, whatever this says.
		const fee = form.querySelector<HTMLElement>("[data-same-day-fee]")!;
		const showFee = () => (fee.textContent = service.selectedOptions[0]?.dataset.fee ?? "");
		service.addEventListener("change", showFee);
		showFee();

		// The time picker has already stopped a submit without a time by now.
		form.addEventListener("submit", (event) => {
			if (event.defaultPrevented) return;
			// One request per press; the worker would only file a second one as the same request.
			send.disabled = true;
			send.classList.add("is-sending");
			sendLabel.textContent = "Sending…";
		});
		// The back button brings the page back as it was left, so turn the button on again then.
		window.addEventListener("pageshow", () => {
			send.disabled = false;
			send.classList.remove("is-sending");
			sendLabel.textContent = "Send request";
		});
	}
</script>

<style is:global>
	/* Form styles the time picker and the character counts share with the page. Global, but only on
	   this page: the home page has its own .card. */
	/* The card is a wrapper, not the fieldset: Safari draws a fieldset's legend on its border. */
	.card {
		padding: 1.5rem;
		background: var(--surface);
		border: 1px solid var(--line);
		border-radius: 0.75rem;
		transition: border-color 0.2s;
	}
	.card:focus-within {
		border-color: color-mix(in srgb, var(--accent) 45%, var(--line));
	}
	fieldset {
		display: grid;
		gap: 1rem;
		min-width: 0;
		margin: 0;
		padding: 0;
		border: 0;
	}
	legend {
		margin-bottom: 1rem;
		padding: 0;
		font-size: 1.125rem;
		font-weight: 700;
	}
	label {
		display: grid;
		gap: 0.375rem;
		font-weight: 600;
		font-size: 0.9375rem;
	}
	input:not([type="checkbox"]),
	select,
	textarea {
		box-sizing: border-box;
		width: 100%;
		padding: 0.625rem 0.75rem;
		border: 1px solid var(--line);
		border-radius: 0.5rem;
		background: var(--bg);
		color: var(--ink);
		font: inherit;
		font-weight: 400;
	}
	input:focus-visible,
	select:focus-visible,
	textarea:focus-visible {
		outline: 2px solid var(--accent);
		outline-offset: 0;
		border-color: var(--accent);
	}
	textarea {
		resize: vertical;
	}
	/* Fields left wrong after editing get a red edge; untouched ones stay plain. */
	input:user-invalid,
	textarea:user-invalid {
		border-color: var(--error);
	}
	.hint,
	.optional {
		margin: 0;
		color: var(--muted);
		font-size: 0.875rem;
		font-weight: 400;
	}
	/* A field's hint sits closer to it than to the next field: inside the fieldset's grid gap, and
	   under the notes field, which has no fieldset. */
	label + .hint {
		margin-top: -0.625rem;
	}
	.card > label + .hint {
		margin-top: 0.375rem;
	}
	/* An empty error takes no space but stays in the accessibility tree, so screen readers keep
	   listening to it as a live region. */
	.error:empty {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.error {
		margin: 0;
		color: var(--error);
		font-size: 0.9375rem;
		font-weight: 600;
	}
</style>

<style>
	main {
		max-width: 44rem;
		padding-block: clamp(3rem, 2rem + 4vw, 5rem);
	}
	h1 {
		margin: 0;
	}
	.lede {
		margin: 1rem 0 2rem;
		color: var(--muted);
	}
	form {
		--error: #b42318;
	}
	form,
	.fields {
		display: grid;
		gap: 1.25rem;
	}
	@media (prefers-color-scheme: dark) {
		form {
			--error: #fda29b;
		}
	}
	.check {
		display: flex;
		align-items: center;
		gap: 0.625rem;
		cursor: pointer;
	}
	.check input {
		flex: none;
		width: 1.25rem;
		height: 1.25rem;
		margin: 0;
		accent-color: var(--accent);
	}
	.notice {
		margin: 0;
		padding: 1rem 1.25rem;
		border: 1px solid var(--accent);
		border-radius: 0.75rem;
		background: var(--surface);
	}
	.notice:focus {
		outline: 2px solid var(--accent);
		outline-offset: 2px;
	}
	.notice[hidden],
	.fields[hidden],
	[data-quantity][hidden],
	.loading[hidden] {
		display: none;
	}
	.loading {
		display: grid;
		gap: 0.75rem;
	}
	.skeleton {
		display: grid;
		gap: 1.25rem;
	}
	.skeleton span {
		height: 8rem;
		border-radius: 0.75rem;
		background: linear-gradient(
				100deg,
				transparent 30%,
				color-mix(in srgb, var(--accent) 8%, transparent) 50%,
				transparent 70%
			)
			var(--surface);
		background-size: 200% 100%;
		border: 1px solid var(--line);
	}
	/* Cards and notices come in softly when the times load. One of the cards is the time picker's,
	   so the cards are matched globally. */
	@media (prefers-reduced-motion: no-preference) {
		.skeleton span {
			animation: shimmer 1.4s linear infinite;
		}
		.fields:not([hidden]) > :global(*),
		.notice:not([hidden]) {
			animation: rise 0.5s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
		}
		.fields > :global(:nth-child(2)) {
			animation-delay: 0.06s;
		}
		.fields > :global(:nth-child(3)) {
			animation-delay: 0.12s;
		}
		.fields > :global(:nth-child(4)) {
			animation-delay: 0.18s;
		}
		.fields > :global(:nth-child(n + 5)) {
			animation-delay: 0.24s;
		}
	}
	@keyframes shimmer {
		from {
			background-position: 150% 0;
		}
		to {
			background-position: -50% 0;
		}
	}
	@keyframes rise {
		from {
			opacity: 0;
			transform: translateY(0.75rem);
		}
	}
	/* Same-day is a choice card: the whole box is the target and lights up when picked. */
	.rush {
		align-items: flex-start;
		padding: 0.875rem 1rem;
		border: 1px solid var(--line);
		border-radius: 0.625rem;
		transition:
			border-color 0.15s,
			background-color 0.15s;
	}
	.rush:hover {
		border-color: color-mix(in srgb, var(--accent) 50%, var(--line));
	}
	.rush:has(input:checked) {
		border-color: var(--accent);
		background: color-mix(in srgb, var(--accent) 8%, transparent);
	}
	.rush input {
		margin-top: 0.125rem;
	}
	.rush-text {
		display: grid;
		gap: 0.25rem;
	}
	.check .hint {
		margin: 0;
	}
	.spinner {
		display: none;
		width: 1em;
		height: 1em;
		margin-right: 0.5rem;
		border: 2px solid currentColor;
		border-right-color: transparent;
		border-radius: 50%;
		animation: spin 0.7s linear infinite;
	}
	.is-sending .spinner {
		display: inline-block;
	}
	button:disabled {
		cursor: progress;
		opacity: 0.85;
	}
	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}
	.trap {
		position: absolute;
		left: -100vw;
	}
	button {
		justify-self: start;
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	@media (max-width: 40rem) {
		button {
			justify-self: stretch;
		}
	}
</style>
